<span class="user-avatar-wrap" tabindex="0" aria-label="@Name">
    <span class="user-avatar user-avatar-@Size avatar-color-@ColorIndex @CssClass" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="" loading="lazy" />
        }
        else
        {
            <span>@Initials</span>
        }
    </span>
    <span class="user-avatar-tooltip" role="tooltip">@Name</span>
</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "User";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? ColorKey { get; set; }
    [Parameter] public string CssClass { get; set; } = "";

    private string Initials
    {
        get
        {
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return parts.Length == 0
                ? "?"
                : string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
        }
    }

    private int ColorIndex
    {
        get
        {
            unchecked
            {
                uint hash = 2166136261;
                foreach (var character in ColorKey ?? Name)
                {
                    hash ^= character;
                    hash *= 16777619;
                }
                return (int)(hash % 8);
            }
        }
    }
}
