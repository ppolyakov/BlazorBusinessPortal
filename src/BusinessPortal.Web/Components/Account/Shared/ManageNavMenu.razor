@using Microsoft.AspNetCore.Identity
@using BusinessPortal.Infrastructure

@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage" Match="NavLinkMatch.All"><span class="account-nav-icon"><PortalIcon Name="account" /></span><span>Profile</span></NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/Email"><span class="account-nav-icon"><PortalIcon Name="mail" /></span><span>Email</span></NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/ChangePassword"><span class="account-nav-icon"><PortalIcon Name="key" /></span><span>Password</span></NavLink>
    </li>
    @if (hasExternalLogins)
    {
        <li class="nav-item">
            <NavLink class="nav-link" href="Account/Manage/ExternalLogins"><span class="account-nav-icon"><PortalIcon Name="link" /></span><span>External logins</span></NavLink>
        </li>
    }
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/TwoFactorAuthentication"><span class="account-nav-icon"><PortalIcon Name="shield" /></span><span>Two-factor authentication</span></NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/Passkeys"><span class="account-nav-icon"><PortalIcon Name="passkey" /></span><span>Passkeys</span></NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/PersonalData"><span class="account-nav-icon"><PortalIcon Name="database" /></span><span>Personal data</span></NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
