@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="main-shell">
        <header class="topbar">
            <div class="topbar-context">
                <div class="topbar-label">Business workspace</div>
                <strong class="topbar-title">Operations workspace</strong>
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="topbar-user-actions">
                        <NotificationCenter />
                        <CurrentIdentity />
                    </div>
                </Authorized>
                <NotAuthorized><strong>Welcome to Vela</strong></NotAuthorized>
            </AuthorizeView>
        </header>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
