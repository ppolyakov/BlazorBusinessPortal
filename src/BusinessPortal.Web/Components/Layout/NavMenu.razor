@implements IDisposable
@inject NavigationManager NavigationManager

<div class="brand">
    <BrandLogo />
    <span class="brand-copy"><strong>Vela</strong><small>Work, clearly.</small></span>
</div>

<input type="checkbox" id="nav-toggle" class="nav-toggle" />
<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation"><span></span><span></span><span></span></label>

<nav class="portal-nav" aria-label="Primary navigation">
    <AuthorizeView>
        <Authorized>
            <span class="nav-section-label">Workspace</span>
            <NavLink href="" Match="NavLinkMatch.All"><PortalIcon Name="dashboard" /> <span>Dashboard</span></NavLink>
            <NavLink href="clients"><PortalIcon Name="clients" /> <span>Clients</span></NavLink>
            <NavLink href="projects"><PortalIcon Name="projects" /> <span>Projects</span></NavLink>
            <NavLink href="work-items"><PortalIcon Name="work" /> <span>Work items</span></NavLink>
            <NavLink href="my-time"><PortalIcon Name="time" /> <span>My time</span></NavLink>
            <AuthorizeView Roles="@PortalRoles.Management" Context="managementAuth">
                <span class="nav-section-label">Management</span>
                <NavLink href="approvals"><PortalIcon Name="approvals" /> <span>Approvals</span></NavLink>
                <NavLink href="reports"><PortalIcon Name="reports" /> <span>Reports</span></NavLink>
            </AuthorizeView>
            <AuthorizeView Roles="@PortalRoles.Administrator" Context="adminAuth">
                <NavLink href="audit"><PortalIcon Name="audit" /> <span>Audit history</span></NavLink>
            </AuthorizeView>
            <div class="nav-spacer"></div>
        </Authorized>
        <NotAuthorized>
            <NavLink href="Account/Login"><PortalIcon Name="arrow" /> <span>Sign in</span></NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

<div class="sidebar-foot">
    <span class="status-dot"></span>
    <span><strong>Workspace online</strong><small>Secure tenant environment</small></span>
</div>

@code {
    protected override void OnInitialized() => NavigationManager.LocationChanged += OnLocationChanged;
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => StateHasChanged();
    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
