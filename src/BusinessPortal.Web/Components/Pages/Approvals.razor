@page "/approvals"
@attribute [Authorize(Roles = PortalRoles.Management)]
@inject ITimeEntryService TimeEntryService
@inject ToastService Toasts

<PageTitle>Approvals · Vela</PageTitle>
<PageHeader Eyebrow="Review queue" Title="Time approvals" Description="Review submitted work from other team members. Every decision is audited and concurrency-safe." />

@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }

<ConfirmationModal Visible="@(approving is not null)"
                   Title="Approve time entry"
                   Message="@(approving is null ? "" : $"Approve {approving.Hours:0.##} hours for {approving.UserName}?")"
                   ConfirmText="Approve entry"
                   Busy="deciding"
                   Confirmed="ConfirmApprove"
                   Cancelled="CancelApprove" />

<PortalModal Visible="@(rejecting is not null)" Title="Reject time entry" Closed="CancelReject">
    @if (rejecting is not null)
    {
        <p>@rejecting.WorkDate.ToString("yyyy-MM-dd") · @rejecting.ProjectName · @rejecting.Hours.ToString("0.##") hours</p>
        <div class="field"><label for="reject-comment">Reviewer feedback</label><textarea id="reject-comment" class="form-control" @bind="rejectComment"></textarea></div>
        <div class="head-actions"><button class="btn btn-danger-soft" disabled="@(deciding || string.IsNullOrWhiteSpace(rejectComment))" @onclick="ConfirmReject">@(deciding ? "Working…" : "Reject entry")</button><button class="btn btn-quiet" disabled="@deciding" @onclick="CancelReject">Cancel</button></div>
    }
</PortalModal>

<section class="panel">
    @if (result is null) { <LoadingState Text="Loading approval queue…" /> }
    else if (result.Items.Count == 0) { <EmptyState Title="The queue is clear" Description="Submitted time from other team members will appear here." /> }
    else
    {
        <div class="table-shell">
            <QuickGrid Items="@result.Items.AsQueryable()" Class="quick-grid">
                <TemplateColumn Title="Employee"><PersonCell Name="@context.UserName" ImageUrl="@context.UserAvatarUrl" ColorKey="@context.UserId" Secondary="@context.WorkDate.ToString("yyyy-MM-dd")" /></TemplateColumn>
                <TemplateColumn Title="Work"><strong>@context.ProjectName</strong><div class="muted">@context.WorkItemTitle</div></TemplateColumn>
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.Hours" Title="Hours" Format="0.##" Class="cell-number" />
                <TemplateColumn Title="Decision" Class="cell-actions"><div class="head-actions"><button class="btn btn-primary btn-sm" @onclick="() => BeginApprove(context)">Approve</button><button class="btn btn-danger-soft btn-sm" @onclick="() => BeginReject(context)">Reject</button></div></TemplateColumn>
            </QuickGrid>
        </div>
        <Pager Page="@result.Page" TotalPages="@result.TotalPages" TotalCount="@result.TotalCount" PageSize="@pageSize" Changed="ChangePage" PageSizeChanged="ChangePageSize" />
    }
</section>

@code {
    private PageResult<TimeEntryListItem>? result;
    private TimeEntryListItem? approving;
    private TimeEntryListItem? rejecting;
    private string rejectComment = "";
    private string? error;
    private bool deciding;
    private int page = 1;
    private int pageSize = 20;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() => result = await TimeEntryService.ApprovalsAsync(new(page, pageSize));
    private async Task ChangePage(int value) { page = value; await Load(); }
    private async Task ChangePageSize(int value) { pageSize = value; page = 1; await Load(); }
    private void BeginApprove(TimeEntryListItem item)
    {
        error = null;
        approving = item;
    }
    private void CancelApprove() => approving = null;
    private async Task ConfirmApprove()
    {
        if (approving is null) return;
        var item = approving;
        deciding = true;
        try
        {
            await Run(() => TimeEntryService.ApproveAsync(item.Id, item.Version), "Time entry approved.");
            approving = null;
        }
        finally { deciding = false; }
    }
    private void BeginReject(TimeEntryListItem item) { rejecting = item; rejectComment = ""; }
    private void CancelReject() { if (!deciding) rejecting = null; }
    private async Task ConfirmReject()
    {
        if (rejecting is null) return;
        deciding = true;
        try
        {
            await Run(() => TimeEntryService.RejectAsync(rejecting.Id, rejecting.Version, rejectComment), "Time entry rejected with feedback.");
            rejecting = null;
        }
        finally { deciding = false; }
    }
    private async Task Run(Func<Task> operation, string success) { try { error = null; await operation(); Toasts.Success(success); await Load(); } catch (Exception ex) { error = ex.Message; } }
}
