@page "/audit"
@attribute [Authorize(Roles = PortalRoles.Administrator)]
@inject IAuditService AuditService

<PageTitle>Audit · Vela</PageTitle>
<PageHeader Eyebrow="Administration" Title="Audit history" Description="A concise, tenant-scoped record of important changes and workflow decisions." />

@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
<section class="panel">
    <div class="toolbar">
        <div class="filter-bar">
            <div class="field">
                <label for="audit-action">Action</label>
                <PortalSelect TValue="string" Id="audit-action" MenuLabel="Audit action" Searchable="true" Options="ActionOptions" @bind-Value="action" />
            </div>
            <div class="field">
                <label for="audit-entity">Entity type</label>
                <PortalSelect TValue="string" Id="audit-entity" MenuLabel="Audit entity type" Searchable="true" Options="EntityTypeOptions" @bind-Value="entityType" />
            </div>
            <div class="field"><label for="audit-from">From</label><PortalDatePicker TValue="NullableDateOnly" Id="audit-from" @bind-Value="from" /></div>
            <div class="field"><label for="audit-through">Through</label><PortalDatePicker TValue="NullableDateOnly" Id="audit-through" @bind-Value="through" /></div>
            <button class="btn btn-quiet" @onclick="Apply">Apply</button>
        </div>
    </div>
    @if (result is null) { <LoadingState Text="Loading audit history…" /> }
    else if (result.Items.Count == 0) { <EmptyState Title="No audit events" Description="No events match the selected filters." /> }
    else
    {
        <div class="table-shell">
            <PortalQuickGrid TGridItem="AuditListItem" Items="@result.Items.AsQueryable()" Class="quick-grid">
                <TemplateColumn Title="Number" SortBy="@sortByNumber" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Ascending" Class="cell-reference">@context.EntityId</TemplateColumn>
                <PropertyColumn Property="x => x.OccurredAtUtc" Title="UTC time" Format="yyyy-MM-dd HH:mm" Sortable="true" Class="cell-date" />
                <TemplateColumn Title="Actor" SortBy="@sortByActor"><PersonCell Name="@context.UserName" ImageUrl="@context.UserAvatarUrl" ColorKey="@context.UserId" /></TemplateColumn>
                <TemplateColumn Title="Action" SortBy="@sortByAction"><AuditBadge Value="@context.Action" /></TemplateColumn>
                <TemplateColumn Title="Entity" SortBy="@sortByEntity"><AuditBadge Value="@context.EntityType" Entity="true" /></TemplateColumn>
                <PropertyColumn Property="x => x.Summary" Title="Safe summary" Sortable="true" />
            </PortalQuickGrid>
        </div>
        <Pager Page="@result.Page" TotalPages="@result.TotalPages" TotalCount="@result.TotalCount" PageSize="@pageSize" Changed="ChangePage" PageSizeChanged="ChangePageSize" />
    }
</section>

@code {
    private PageResult<AuditListItem>? result;
    private AuditFilterOptions filterOptions = new([], []);
    private string? action;
    private string? entityType;
    private DateOnly? from = DateOnly.FromDateTime(DateTime.Today).AddMonths(-2);
    private DateOnly? through = DateOnly.FromDateTime(DateTime.Today);
    private string? error;
    private int page = 1;
    private int pageSize = 20;
    private static readonly GridSort<AuditListItem> sortByNumber = GridSort<AuditListItem>.ByAscending(x => x.EntityId);
    private static readonly GridSort<AuditListItem> sortByActor = GridSort<AuditListItem>.ByAscending(x => x.UserName);
    private static readonly GridSort<AuditListItem> sortByAction = GridSort<AuditListItem>.ByAscending(x => x.Action);
    private static readonly GridSort<AuditListItem> sortByEntity = GridSort<AuditListItem>.ByAscending(x => x.EntityType);
    private IReadOnlyList<PortalSelectOption<string>> ActionOptions => filterOptions.Actions
        .OrderBy(AuditDisplay.ActionLabel)
        .Select(value => new PortalSelectOption<string>(value, AuditDisplay.ActionLabel(value)))
        .Prepend(new(null!, "All actions"))
        .ToArray();
    private IReadOnlyList<PortalSelectOption<string>> EntityTypeOptions => filterOptions.EntityTypes
        .OrderBy(AuditDisplay.EntityLabel)
        .Select(value => new PortalSelectOption<string>(value, AuditDisplay.EntityLabel(value)))
        .Prepend(new(null!, "All entity types"))
        .ToArray();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            filterOptions = await AuditService.GetFilterOptionsAsync();
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
    private async Task Load() { try { error = null; result = await AuditService.SearchAsync(new(page, pageSize, Sort: "number"), action, entityType, from, through); } catch (Exception ex) { error = ex.Message; } }
    private async Task Apply() { page = 1; await Load(); }
    private async Task ChangePage(int value) { page = value; await Load(); }
    private async Task ChangePageSize(int value) { pageSize = value; page = 1; await Load(); }
}
