@page "/projects"
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IClientService ClientService
@inject ToastService Toasts

<PageTitle>Projects · Vela</PageTitle>
<PageHeader Eyebrow="Delivery" Title="Projects" Description="Plan work, watch budget utilization, and keep delivery status visible.">
    <Actions><AuthorizeView Roles="@PortalRoles.Management"><button class="btn btn-primary" @onclick="Create">New project</button></AuthorizeView></Actions>
</PageHeader>

@if (error is not null && !editing) { <div class="alert alert-danger" role="alert">@error</div> }

<PortalModal Visible="editing" Title="@(editId.HasValue ? "Edit project" : "Create project")" Closed="Cancel">
    @if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
        <EditForm Model="input" OnValidSubmit="Save" FormName="project-form">
            <DataAnnotationsValidator /><ValidationSummary />
            <div class="field-grid">
                <div class="field"><label for="project-client">Client</label><PortalSelect TValue="Guid" Id="project-client" MenuLabel="Project client" Searchable="true" Options="ClientOptions" @bind-Value="input.ClientId" /></div>
                <div class="field"><label for="project-code">Project code</label><InputText id="project-code" class="form-control" @bind-Value="input.Code" /><ValidationMessage For="() => input.Code" /></div>
                <div class="field wide"><label for="project-name">Name</label><InputText id="project-name" class="form-control" @bind-Value="input.Name" /><ValidationMessage For="() => input.Name" /></div>
                <div class="field"><label for="project-status">Status</label><PortalSelect TValue="ProjectStatus" Id="project-status" MenuLabel="Project status" Options="ProjectStatusOptions" @bind-Value="input.Status" /></div>
                <div class="field"><label for="project-budget">Budget hours</label><InputNumber id="project-budget" class="form-control" @bind-Value="input.BudgetHours" /></div>
                <div class="field"><label for="project-start">Start date</label><PortalDatePicker TValue="DateOnly" Id="project-start" @bind-Value="input.StartDate" /></div>
                <div class="field"><label for="project-end">End date</label><PortalDatePicker TValue="NullableDateOnly" Id="project-end" @bind-Value="input.EndDate" /><ValidationMessage For="() => input.EndDate" /></div>
                <div class="field wide"><label for="project-description">Description</label><InputTextArea id="project-description" class="form-control" @bind-Value="input.Description" /></div>
            </div>
            <div class="head-actions"><button class="btn btn-primary" disabled="@saving">@(saving ? "Saving…" : "Save project")</button><button type="button" class="btn btn-quiet" @onclick="Cancel">Cancel</button></div>
        </EditForm>
</PortalModal>

<section class="panel">
    <div class="toolbar">
        <div class="filter-bar">
            <input class="form-control" placeholder="Search name or code" @bind="search" aria-label="Search projects" />
            <PortalSelect TValue="string" Options="ProjectStatusFilterOptions" @bind-Value="statusFilter" aria-label="Filter by status" />
            <button class="btn btn-quiet" @onclick="ApplyFilters">Apply</button>
        </div>
        <span class="muted">Budget uses approved time</span>
    </div>
    @if (result is null) { <LoadingState /> }
    else if (result.Items.Count == 0) { <EmptyState Title="No matching projects" Description="Adjust the filters or create a project." /> }
    else
    {
        <div class="table-shell">
            <QuickGrid Items="@result.Items.AsQueryable()" Class="quick-grid">
                <PropertyColumn Property="x => x.Code" Title="Code" />
                <PropertyColumn Property="x => x.Name" Title="Project" />
                <PropertyColumn Property="x => x.ClientName" Title="Client" />
                <TemplateColumn Title="Status" Class="cell-status"><StatusPill Value="@context.Status" /></TemplateColumn>
                <TemplateColumn Title="Budget" Class="cell-number">
                    <div><strong>@context.UsedHours.ToString("0.#")</strong> / @context.BudgetHours.ToString("0.#")h</div>
                    <div class="bar-track"><div class="bar-fill" style="width:@BudgetPercent(context)%"></div></div>
                </TemplateColumn>
                <PropertyColumn Property="x => x.EndDate" Title="Ends" Format="yyyy-MM-dd" Class="cell-date" />
                <TemplateColumn Title="" Context="project" Class="cell-actions"><div class="head-actions"><a class="btn btn-quiet btn-sm" href="@($"work-items?project={project.Id}")">Tasks</a><AuthorizeView Roles="@PortalRoles.Management" Context="authState"><button class="btn btn-quiet btn-sm" @onclick="() => Edit(project.Id)">Edit</button></AuthorizeView></div></TemplateColumn>
            </QuickGrid>
        </div>
        <Pager Page="@result.Page" TotalPages="@result.TotalPages" TotalCount="@result.TotalCount" PageSize="@pageSize" Changed="ChangePage" PageSizeChanged="ChangePageSize" />
    }
</section>

@code {
    private PageResult<ProjectListItem>? result;
    private IReadOnlyList<ClientListItem> clients = [];
    private ProjectInput input = new();
    private Guid? editId;
    private string? search;
    private string statusFilter = "";
    private string? error;
    private bool editing;
    private bool saving;
    private int page = 1;
    private int pageSize = 20;
    private IReadOnlyList<PortalSelectOption<Guid>> ClientOptions => clients
        .Select(item => new PortalSelectOption<Guid>(item.Id, item.Name, item.ContactName))
        .Prepend(new(Guid.Empty, "Choose a client"))
        .ToArray();
    private static readonly IReadOnlyList<PortalSelectOption<ProjectStatus>> ProjectStatusOptions = Enum.GetValues<ProjectStatus>()
        .Select(value => new PortalSelectOption<ProjectStatus>(value, value.ToString()))
        .ToArray();
    private static readonly IReadOnlyList<PortalSelectOption<string>> ProjectStatusFilterOptions = Enum.GetValues<ProjectStatus>()
        .Select(value => new PortalSelectOption<string>(value.ToString(), value.ToString()))
        .Prepend(new("", "All statuses"))
        .ToArray();

    protected override async Task OnInitializedAsync() { clients = (await ClientService.SearchAsync(new(1, 100))).Items; await Load(); }
    private async Task Load() => result = await ProjectService.SearchAsync(new(page, pageSize, search), status: Enum.TryParse<ProjectStatus>(statusFilter, out var status) ? status : null);
    private async Task ApplyFilters() { page = 1; await Load(); }
    private void Create() { input = new(); editId = null; editing = true; error = null; }
    private async Task Edit(Guid id) { error = null; input = await ProjectService.GetAsync(id); editId = id; editing = true; }
    private void Cancel() { editing = false; error = null; }
    private async Task ChangePage(int value) { page = value; await Load(); }
    private async Task ChangePageSize(int value) { pageSize = value; page = 1; await Load(); }
    private static string BudgetPercent(ProjectListItem item) => Math.Min(100, item.BudgetHours <= 0 ? 0 : item.UsedHours / item.BudgetHours * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    private async Task Save()
    {
        saving = true; error = null;
        try { await ProjectService.SaveAsync(editId, input); editing = false; Toasts.Success("Project saved", $"{input.Code} · {input.Name} is up to date."); await Load(); }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }
}
